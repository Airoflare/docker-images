{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "schedule:weekends"
  ],
  "customManagers": [
    {
      "description": "Pick up `# renovate:` comments on version vars (Trivy, build-time cosign)",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/.+\\.ya?ml$/",
        "/(^|/)fetch-aube\\.sh$/",
        "/(^|/)scripts/helpers/.+\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Za-z_]+ *[:=] *['\"]?(?<currentValue>[^\\s'\"]+)"
      ],
      "extractVersionTemplate": "^v?(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Stay on Node 24 (LTS). Change this to move to a new major.",
      "matchDatasources": ["docker"],
      "matchDepNames": ["node"],
      "allowedVersions": "<25"
    },
    {
      "description": "Stay on Maven 3.9 for castlemock: Maven 3.10 rejects the duplicate jackson-databind entry in the frozen castlemock pom.xml",
      "matchDatasources": ["docker"],
      "matchDepNames": ["maven"],
      "matchFileNames": ["images/castlemock/Dockerfile"],
      "allowedVersions": "<3.10"
    },
    {
      "description": "One PR for all GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "One PR for Alpine: the base image tags and the ALPINE_RELEASE helper pin must move together",
      "matchDatasources": ["docker"],
      "matchDepNames": ["alpine"],
      "groupName": "Alpine"
    }
  ]
}
