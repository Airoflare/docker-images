{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "schedule:weekends"
  ],
  "customManagers": [
    {
      "description": "Pick up `# renovate:` comments on version vars (Trivy, build-time cosign)",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/.+\\.ya?ml$/",
        "/(^|/)fetch-aube\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Za-z_]+ *[:=] *['\"]?(?<currentValue>[^\\s'\"]+)"
      ],
      "extractVersionTemplate": "^v?(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Stay on Node 24 (LTS). Change this to move to a new major.",
      "matchDatasources": ["docker"],
      "matchDepNames": ["node"],
      "allowedVersions": "<25"
    },
    {
      "description": "One PR for all GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    }
  ]
}
